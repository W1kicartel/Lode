{
  "name": "lode",
  "productName": "Lode",
  "version": "0.3.0",
  "description": "L'assistente di studio in cima allo schermo, collegato al tuo vault Obsidian",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "prepara": "node prepara.mjs",
    "start": "electron .",
    "dist:mac": "node prepara.mjs && electron-builder --mac --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "dist:win": "node prepara.mjs && electron-builder --win nsis --publish never",
    "dist:linux": "node prepara.mjs && electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "it.lode.app",
    "productName": "Lode",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "W1kicartel",
        "repo": "Lode",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.mjs",
      "preload.cjs",
      "vault.mjs",
      "installa.mjs",
      "voce.mjs",
      "progetto.mjs",
      "esegui.mjs",
      "aggiorna.mjs",
      "web/**",
      "package.json",
      "build/tray*.png"
    ],
    "mac": {
      "category": "public.app-category.education",
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "lode-voce"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Lode usa il microfono quando parli con lui, per «Ripeti» in aula e per trascrivere le lezioni che scegli. L'audio non viene mai salvato."
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Lode-${version}-mac.${ext}",
      "x64ArchFiles": "Contents/Resources/bin/lode-voce"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Lode-${version}-windows.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Education",
      "artifactName": "Lode-${version}-linux.${ext}"
    },
    "artifactName": "Lode-${version}-${os}.${ext}"
  }
}
